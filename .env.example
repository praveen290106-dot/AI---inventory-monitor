# ========================================================
# AI-Powered Inventory Monitor - Environment Configuration
# ========================================================

SECRET_KEY=college_inventory_monitor_secret_key_2026
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

DATABASE_URL=sqlite:///database/inventory.db

# ========================================================
# Azure OpenAI / Microsoft Foundry Endpoints & Keys
# ========================================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your_azure_openai_key
TEXT_MODEL_DEPLOYMENT=gpt-4.1-mini
VISION_MODEL_DEPLOYMENT=gpt-4.1-mini
IMAGE_MODEL_DEPLOYMENT=FLUX.2-flex

# Speech-to-Text
SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
SPEECH_API_KEY=your_speech_key
SPEECH_REGION=eastus

# Content Understanding
CONTENT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
CONTENT_KEY=your_content_key
CONTENT_API_VERSION=2025-11-01

# Microsoft Foundry Backward Compatibility
FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
FOUNDRY_API_KEY=your_foundry_key
FOUNDRY_DEPLOYMENT_NAME=gpt-4.1-mini
FOUNDRY_API_VERSION=2024-06-01
